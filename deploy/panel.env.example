# Copy to /etc/ops-panel/panel.env. The master key is read from
# $CREDENTIALS_DIRECTORY/master.key via systemd LoadCredential, not from here.
OPS_LISTEN=127.0.0.1:8080
OPS_DB=/var/lib/ops-panel/panel.db
OPS_BASE_URL=https://panel.internal
# Phase 2 (GitHub App):
# OPS_GITHUB_APP_ID=
# OPS_GITHUB_APP_KEY=/etc/ops-panel/github-app.pem
# OPS_ALERT_WEBHOOK=
