package components

// AuthBase is the minimal shell for the login / TOTP / enrollment pages (the
// only server-rendered pages left; everything else is the React SPA at /app/).
templ AuthBase(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · RedCi</title>
			<link rel="stylesheet" href="/static/app.css"/>
		</head>
		<body>
			<div class="auth-wrap">
				{ children... }
			</div>
		</body>
	</html>
}
